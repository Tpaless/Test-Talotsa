static func get_character(character_id: String) -> Dictionary:
	return CHARACTERS.get(character_id, {}).duplicate(true)


static func get_stage(stage: int) -> Dictionary:
	return STAGES.get(stage, {}).duplicate(true)


static func get_boss_name(stage: int) -> String:
	return str(STAGES.get(stage, {}).get("boss", "บอส"))


static func get_stage_area(stage: int) -> String:
	return str(STAGES.get(stage, {}).get("area", "พื้นที่ไม่ทราบชื่อ"))


static func get_record_name(stage: int) -> String:
	return str(STAGES.get(stage, {}).get("record", ""))


static func get_intro_lines(stage: int) -> Array[Dictionary]:
	return _build_lines(INTRO_BY_STAGE.get(stage, []))


# คืนบทหลังชนะ Phase และรวมคำเกริ่น Phase ถัดไปตาม Game Design
static func get_lines(stage: int, stage_level: int = 3) -> Array[Dictionary]:
	var stage_lines: Dictionary = AFTER_PHASE_BY_STAGE.get(stage, {})
	return _build_lines(stage_lines.get(stage_level, []))


static func _build_lines(raw_lines: Array) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for raw_line in raw_lines:
		if not raw_line is Array or raw_line.size() < 2:
			continue
		var character: Dictionary = CHARACTERS.get(str(raw_line[0]), CHARACTERS.johny)
		var line := {
			"character_id": str(raw_line[0]),
			"speaker": str(character.name),
			"text": str(raw_line[1]),
			"portrait": str(character.portrait),
			"accent": str(character.accent)
		}
		if raw_line.size() >= 3 and not str(raw_line[2]).is_empty():
			line["hint"] = str(raw_line[2])
		result.append(line)
	return result
